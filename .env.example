# Store production secrets only in an encrypted deployment environment.
DATABASE_URL=
AUTH_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/office
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/office
NEXT_PUBLIC_CLERK_ACCOUNT_PORTAL_URL=
CLERK_SAML_DOMAIN=rosstaxsoftware.com
CLERK_SAML_CONNECTION_ID=
CLERK_OWNER_EMAIL=
CLERK_OWNER_USERNAME=
CLERK_OWNER_PHONE=
# IRS-issued identifiers. Configure only in the encrypted production environment.
CLERK_OWNER_PTIN=
CLERK_OWNER_CAF=
CLERK_OWNER_EFIN=
# Strict RBAC issuance workflow: invite creates no active role; issue requires verified email + MFA.
ACCESS_ISSUANCE_ACTION=
ACCESS_ISSUANCE_APPROVED=false
ACCESS_ISSUANCE_APPROVER=
ACCESS_ISSUANCE_TICKET=
IRS_CLIENT_ID=
IRS_CLIENT_SECRET=
IRS_REDIRECT_URI=https://etrac.rosstaxsoftware.com/oauth/callback
# Stripe keys belong only in encrypted deployment configuration. Never commit live keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_CATALOG_VERSION=2026-09-16
# Set true only after the CRM/order persistence migration and billing event adapter are verified.
STRIPE_CRM_PERSISTENCE_VERIFIED=false
# Enable only after applicable tax registrations/settings are confirmed in Stripe Tax.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Catalog seed is dry-run unless explicitly enabled for a controlled administrative run.
STRIPE_CATALOG_SEED_APPLY=false
# Durable billing/CRM adapter. It must atomically authorize orders and persist Stripe event evidence.
BILLING_EVENT_ADAPTER_URL=
BILLING_EVENT_ADAPTER_TOKEN=
APP_URL=https://rosstaxsoftware.com
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=2555
ENCRYPTION_KEY_ID=
ENCRYPTION_KEY_VERSION=
# Base64-encoded 32-byte development key only. Production must use a KMS/HSM integration.
DATA_ENCRYPTION_KEY_B64=
AUDIT_SIGNING_KEY_ID=
AUDIT_SIGNING_PUBLIC_KEY_PEM=
TLS_CERTIFICATE_REFERENCE=
OBJECT_STORAGE_BUCKET=
QUEUE_URL=
EMAIL_FROM=
AI_GATEWAY_API_KEY=
AI_GATEWAY_GEMINI_MODEL=google/gemini-3-pro-preview
# Durable worker adapter. Production Vercel prefers its short-lived VERCEL_OIDC_TOKEN.
# WORKER_ADAPTER_TOKEN remains a fallback for local/controlled administration only.
# Keep execution false until the dedicated database is provisioned, migrations are applied,
# and worker executor verification succeeds.
WORKER_ADAPTER_URL=
WORKER_ADAPTER_TOKEN=
WORKER_ADAPTER_EXECUTION_ENABLED=false
# Render-side Vercel workload identity trust boundary. These are identifiers, not secrets.
VERCEL_EXPECTED_OWNER_ID=
VERCEL_EXPECTED_PROJECT_ID=
VERCEL_EXPECTED_ENVIRONMENT=production
# Optional override. Default audience is https://vercel.com/<owner-slug> from the signed token.
VERCEL_EXPECTED_AUDIENCE=
# Operations control-plane policy limits. Provider quotas still require provider evidence.
OPS_MAX_CONCURRENT_JOBS=25
OPS_MAX_JOB_RETRIES=5
OPS_MAX_EVIDENCE_AGE_MINUTES=1440
OPS_MAINTENANCE_WINDOW=
NATIONAL_STUDENT_CLEARINGHOUSE_ENABLED=false
FEDERAL_STUDENT_AID_ENABLED=false
REMOTE_PROCTORING_ENABLED=false
ACADEMIC_APPLICATIONS_ENABLED=false
