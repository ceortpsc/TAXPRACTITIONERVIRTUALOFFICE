{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rosstaxsoftware.com/schemas/security-policy/v1",
  "type": "object",
  "required": ["version", "classification", "encryption", "redaction", "xml", "audit", "separationOfDuties", "certificationStatement"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classification": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } },
    "encryption": { "type": "object", "required": ["atRest", "inTransit", "keyProvider", "rotationDays"] },
    "redaction": { "type": "array", "minItems": 1, "uniqueItems": true },
    "xml": { "type": "object", "required": ["maxBytes", "doctype", "externalEntities", "schemaValidationRequired"] },
    "audit": { "type": "object", "required": ["appendOnly", "hashAlgorithm", "signing", "retentionDays"] },
    "separationOfDuties": { "type": "array", "minItems": 1, "uniqueItems": true },
    "certificationStatement": { "type": "string", "minLength": 20 }
  },
  "additionalProperties": false
}
